// Lox test suite — exercise as many language features as practical.
// Each test prints its results, then prints a blank line (print "";)
// No arrays used. Adjust expected values if your interpreter differs.

//
// 1) Arithmetic, precedence, unary, grouping
//
print 1 + 2 * 3; // expect 7
print (1 + 2) * 3; // expect 9
print -5 + 2; // expect -3
print 3 > 2 and 2 < 4; // expect true
print "";

//
// 2) Variables, reassignment, shadowing, block scope
//
var a = "global";
{
var a = "inner";
print a; // expect "inner"
}
print a; // expect "global"
fun scopeTest() {
var a = "func";
{
var a = "nested";
print a; // expect "nested"
}
print a; // expect "func"
}
scopeTest();
print "";

//
// 3) If / else
//
fun check(x) {
if (x > 0) {
print "positive";
} else if (x < 0) {
print "negative";
} else {
print "zero";
}
}
check(5); // positive
check(-2); // negative
check(0); // zero
print "";

//
// 4) Loops and break
//
var i = 0;
while (true) {
i = i + 1;
if (i == 3) break;
}
print i; // expect 3
print "";

/*
//
// 5) Functions: parameters, return, nil when none returned
//
fun add(x, y) {
return x + y;
}
print add(10, 20); // expect 30

fun noReturn() {
var x = 1;
}
print noReturn(); // expect nil
print "";
*/

//
// 6) First-class functions and assignment
//
fun mul(a, b) {
return a * b;
}
var times = mul;
print times(4, 5); // expect 20
print "";

//
// 7) Closures and captured state
//
fun makeCounter() {
var count = 0;
fun inc() {
count = count + 1;
return count;
}
return inc;
}
var c = makeCounter();
print c(); // 1
print c(); // 2
print c(); // 3
print "";

//
// 8) Closure captures lexical environment (test lifetimes)
//
var later;
{
var v = "captured";
fun show() { return v; }
later = show;
}
print later(); // expect "captured"
print "";

//
// 9) Recursion
//
fun fact(n) {
if (n <= 1) return 1;
return n * fact(n - 1);
}
print fact(5); // expect 120
print "";

//
// 10) Equality and nil
//
print (1 == 1); // true
print (1 != 2); // true
print (nil == nil); // true
print (nil != 0); // true (nil !== any non-nil)
print "";

//
// 11) Strings concatenation and to-string
//
print "hello " + "world"; // expect "hello world"
print "";

//
// 12) Logical operators short-circuit behavior
//
fun left() {
print "left-evaluated";
return true;
}
fun right() {
print "right-evaluated";
return false;
}
print (left() or right()); // left-evaluated, then prints true
print (false and right()); // short-circuits, right not evaluated, prints false
print "";

//
// 13) Methods, fields, this, constructors (init)
//
class Point {
init(x, y) {
this.x = x;
this.y = y;
}
dist() {
return (this.x * this.x) + (this.y * this.y);
}
}
var p = Point(3, 4);
print p.dist(); // expect 25
print "";

//
// 14) Methods as closures (method bound to instance)
//
class Acc {
init() { this.v = 0; }
inc() { this.v = this.v + 1; return this.v; }
}
var a1 = Acc();
var m = a1.inc;
print m(); // expect 1 (method bound to receiver)
print m(); // expect 2
print "";

//
// 15) Inheritance and super
//
class A {
greet() { return "A"; }
}
class B < A {
greet() { return "B-" + super.greet(); }
}
var b = B();
print b.greet(); // expect "B-A"
print "";

//
// 16) Overriding and calling super with state
//
class Animal {
init(name) { this.name = name; }
speak() { return this.name + " makes noise"; }
}
class Dog < Animal {
speak() { return super.speak() + " -> woof"; }
}
var dog = Dog("Rex");
print dog.speak(); // "Rex makes noise -> woof"
print "";

