print "=== literal creation ===";
print [1, 2, 3];                   // expect: [1, 2, 3]
print [];                          // empty array

print "";

print "=== nested arrays ===";
var a = [1, [2, 3], 4];
print a[0];                        // 1
print a[1][0];                     // 2
print a[1][1];                     // 3
print a[2];                        // 4

print "";

print "=== variable assignment and access ===";
var x = [10, 20, 30];
print x[0];                        // 10
print x[1];                        // 20
print x[2];                        // 30

print "";

print "=== mutation ===";
x[1] = 99;
print x;                           // expect [10, 99, 30]

x[0] = x[2];
print x;                           // expect [30, 99, 30]

print "";

print "=== aliasing / reference semantics ===";
var y = x;
y[1] = 777;
print x;                           // should show the mutation if arrays are references
print y;

print "";

