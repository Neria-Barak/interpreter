// -----------------------------------------------------------------------------
// 17) Methods can return functions bound to `this`, and passing them around works
// -----------------------------------------------------------------------------
class BoundTest {
  init(name) {
    this.name = name;
  }

  maker() {
    fun f(a) {
      return this.name + ":" + a;
    }
    return f;
  }
}

var bt = BoundTest("X");
var bound = bt.maker();
print bound("1"); // expected: X:1

print "";

// -----------------------------------------------------------------------------
// 18) Ensure instance identity is preserved (== not defined in Lox; use identity test via field)
// -----------------------------------------------------------------------------
class Ident {
  init(id) {
    this.id = id;
  }
}

var i1 = Ident(1);
var i2 = Ident(1);
print i1.id; // expected: 1
print i2.id; // expected: 1
// If interpreter has identity equality, test it; otherwise check behavior via fields.
// print i1 == i2; // optional, depends on your interpreter

print "";

// -----------------------------------------------------------------------------
// 19) Large example: A small "class bank" with deposit/withdraw and error checks
// -----------------------------------------------------------------------------
class Bank {
  init(name, balance) {
    this.name = name;
    this.balance = balance;
  }

  deposit(a) {
    this.balance = this.balance + a;
    return this.balance;
  }

  withdraw(a) {
    if (a > this.balance) {
      return "insufficient";
    }
    this.balance = this.balance - a;
    return this.balance;
  }

  transferTo(other, amount) {
    var w = this.withdraw(amount);
    if (w == "insufficient") return false;
    other.deposit(amount);
    return true;
  }
}

var accA = Bank("A", 100);
var accB = Bank("B", 25);
print accA.deposit(50); // expected: 150
print accA.withdraw(20); // expected: 130
print accA.transferTo(accB, 200); // expected: false
print accA.transferTo(accB, 30);  // expected: true
print accA.balance; // expected: 100
print accB.balance; // expected: 55

