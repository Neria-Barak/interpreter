// -----------------------------------------------------------------------------
// 12) Methods that return `this` allow chaining
// -----------------------------------------------------------------------------
class Builder {
  init() {
    this.parts = "";
  }
  add(part) {
    this.parts = this.parts + part;
    return this;
  }
  result() {
    return this.parts;
  }
}

var b = Builder();
print b.add("a").add("b").add("c").result(); // expected: abc

print "";

// -----------------------------------------------------------------------------
// 13) Deep nested `this` capture with local functions and closures
// -----------------------------------------------------------------------------
class Deep {
  init(name) {
    this.name = name;
  }

  makeDeeper() {
    fun level1() {
      fun level2() {
        fun level3() {
          return this.name;
        }
        return level3;
      }
      return level2;
    }
    return level1;
  }
}

var d = Deep("deepName");
var l1 = d.makeDeeper();
var l2 = l1();
var l3 = l2();
print l3(); // expected: deepName

print "";

// -----------------------------------------------------------------------------
// 14) Mutating `this` from nested functions
// -----------------------------------------------------------------------------
class Mutate {
  init(x) {
    this.x = x;
  }

  getAndMutate() {
    fun inner() {
      this.x = this.x + 10;
      return this.x;
    }
    print inner(); // expected: original + 10
    return this.x;
  }
}

var mm = Mutate(2);
print mm.getAndMutate(); // expected prints: 12 (inner), then return 12

print "";

