fun sort(arr, n) {
  for (var i = 0; i < n-1; i = i + 1) {
    for (var j = 0; j < n-i-1; j = j + 1) {
      if (arr[j] > arr[j+1]) {
        var temp = arr[j];
        arr[j] = arr[j+1];
        arr[j+1] = temp;
      }
    }
  }
  print arr;
}

var arr = [6,5,4,3,2,1];
print arr;
sort(arr, 6);
print arr;