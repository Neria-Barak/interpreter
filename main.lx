print "=== arrays with different types ===";
var mix = [1, "hi", true, nil, [9]];
print mix[0];
print mix[1];
print mix[2];
print mix[3];
print mix[4][0];

print "";

print "=== overwrite an array element with another array ===";
var w = [1,2,3];
w[1] = ["a", "b"];
print w[1][0];                     // "a"
print w[1][1];                     // "b"
print w;                           // [1, ["a","b"], 3]

print "";
