o.arr[1] = 123;
print o.arr;                       // [5, 123, 7]

print "";
*/

print "=== dynamic index expressions ===";
var i = 0;
var z = [100, 200, 300];
print z[i];                        // 100
i = 1 + 1;
print z[i];                        // 300

print "";

print "=== using array elements inside expressions ===";
var m = [2, 3];
print m[0] + m[1] * 10;            // 2 + 30 = 32

print "";

print "=== array in function return ===";
fun make() {
  return [8, 9];
}
var r = make();
print r;                           // [8, 9]
r[0] = 123;
print r;                           // [123, 9]

print "";

print "=== passing arrays to functions ===";
fun bump(arr) {
  arr[0] = arr[0] + 1;
}
var q = [50];
bump(q);
print q[0];                        // 51

print "";

print "=== deep nesting & mutation ===";
var deep = [[1], [2], [3]];
deep[1][0] = 999;
print deep;                        // [[1], [999], [3]]

print "";

