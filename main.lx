// class_tests.lox
// A large suite of tests for classes, fields, methods, this, and constructors.
// Run as a single file. Each test block is separated by blank lines.


// -----------------------------------------------------------------------------
// 1) Basic class + constructor + field initialization
// -----------------------------------------------------------------------------
class Point {
  init(x, y) {
    this.x = x;
    this.y = y;
  }

  toString() {
    return "(" + this.x + "," + this.y + ")";
  }

  distanceFromOrigin() {
    return (this.x * this.x + this.y * this.y);
  }
}

var p = Point(3, 4);
print p.toString();          // expected: (3,4)
print p.distanceFromOrigin(); // expected: 25

print "";

// -----------------------------------------------------------------------------
// 2) Fields default to nil when not set
// -----------------------------------------------------------------------------
class Empty {}
var e = Empty();
//print e.someField;           // expected: nil

// Setting a field later
e.someField = "set later";
print e.someField;           // expected: set later

print "";

// -----------------------------------------------------------------------------
// 3) Methods can read and write fields
// -----------------------------------------------------------------------------
class Counter {
  init() {
    this.count = 0;
  }

  inc() {
    this.count = this.count + 1;
    return this.count;
  }

  add(n) {
    this.count = this.count + n;
    return this.count;
  }
}

var c = Counter();
print c.inc();    // expected: 1
print c.inc();    // expected: 2
print c.add(8);   // expected: 10
print c.count;    // expected: 10

print "";

// -----------------------------------------------------------------------------
// 4) Multiple independent instances
// -----------------------------------------------------------------------------
var a = Counter();
var b = Counter();
a.add(5);
print a.count; // expected: 5
print b.count; // expected: 0

print "";

// -----------------------------------------------------------------------------
// 5) Constructor calling other methods / ordering
// -----------------------------------------------------------------------------
class Person {
  init(name) {
    // call a helper method from init
    this.setName(name);
  }

  setName(n) {
    this.name = n;
  }

  greet() {
    print "Hi, I'm " + this.name + "!";
  }
}

var p1 = Person("Neria");
p1.greet(); // expected: Hi, I'm Neria!

print "";

// -----------------------------------------------------------------------------
// 6) Methods returning functions that capture `this` (closure captures `this`)
// -----------------------------------------------------------------------------
class Greeter {
  init(name) {
    this.name = name;
  }

  makeGreeter() {
    fun inner() {
      return "hello " + this.name;
    }
    return inner;
  }
}

var g = Greeter("Ada");
var greeterFn = g.makeGreeter();
print greeterFn(); // expected: hello Ada

// Ensure `this` capture works even if we call the returned function later after changes:
g.name = "Grace";
print greeterFn(); // expected: hello Grace

print "";

// -----------------------------------------------------------------------------
// 7) Methods bound to instance when retrieved as values
// -----------------------------------------------------------------------------
class Adder {
  init(base) {
    this.base = base;
  }
  add(n) {
    return this.base + n;
  }
}

var ad = Adder(100);
var fn = ad.add; // should be a bound method capturing `this` = ad
print fn(23);    // expected: 123

// If you assign a method from one instance to call for another instance:
var ad2 = Adder(5);
var fn2 = ad.add; // still bound to ad
print fn2(1);     // expected: 101 (if bound), or runtime error if your impl doesn't bind

print "";

// -----------------------------------------------------------------------------
// 8) Constructor implicitly returns the instance (init); explicit return tests
// -----------------------------------------------------------------------------
class Returner {
  init(x) {
    this.x = x;
    // returning a value from init is usually an error in Crafting Interpreters.
    // The behavior your interpreter has may vary. Uncomment to test behavior.
    // return 123; // expected: runtime error (if implemented like the book), or ignored.
  }

  getX() {
    return this.x;
  }
}

var r = Returner(7);
print r.getX(); // expected: 7

print "";

// -----------------------------------------------------------------------------
// 9) Methods can call other methods on same instance using this
// -----------------------------------------------------------------------------
class Chain {
  init(v) {
    this.v = v;
  }
  add(n) {
    this.v = this.v + n;
    return this;
  }
  mul(n) {
    this.v = this.v * n;
    return this;
  }
  value() {
    return this.v;
  }
}

var ch = Chain(1);
ch.add(2).mul(5).add(3);
print ch.value(); // expected: ((1+2)*5)+3 = 18

