// 15) Constructor throws if used without parentheses? test both ways.
// -----------------------------------------------------------------------------
class NoArgs {
  init() {
    this.ok = "ok";
  }
}

// In Lox you call constructors like NoArgs(). If your language allows NoArgs without (), test both:
// var na = NoArgs;      // ambiguous: class object, not instance
// print na;             // runtime-dependent
var na2 = NoArgs();
print na2.ok; // expected: ok

print "";

