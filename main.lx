//
// 18) Ensure initializer returns instance (implicit)
//
class C {
init() { this.ok = "yes"; }
check() { return this.ok; }
}
var cObj = C();
print cObj.check(); // expect "yes"
print "";

//
// 19) Higher-order functions and composition
//
fun compose(f, g) {
fun h(x) { return f(g(x)); }
return h;
}
fun inc1(n) { return n + 1; }
fun mul2(n) { return n * 2; }
var doubInc = compose(inc1, mul2);
print doubInc(3); // mul2(3)=6, inc1(6)=7 -> expect 7
print "";

//
// 20) Edge: calling a non-function should error in a real interpreter — here we only test valid call
//
fun identity(x) { return x; }
print identity("works");
print "";

// End of test suite. If any test fails, check: scoping, closures, methods, super, returns, and truthiness.